# Copy to a file outside the repository. Every value marked REPLACE is mandatory.
LETS_IMAGE=ghcr.io/astraldeep/lets@sha256:REPLACE_WITH_64_LOWERCASE_HEX
LETS_RUNTIME_PROVIDER=generic-production
LETS_SERVER_NAME=warden-a.example.net

# Use five distinct, pre-created backup/security domains.
LETS_STATE_DIR=/srv/lets-state/warden-a
LETS_AUTHORITY_DIR=/srv/lets-authority/warden-a
LETS_AUDIT_DIR=/srv/lets-audit/warden-a
LETS_BACKUP_DIR=/srv/lets-backup/warden-a
LETS_TRUST_DIR=/etc/lets/warden-a/trust
LETS_CONFIG_FILE=/etc/lets/warden-a/config.json

# These identifiers are operator assertions about independently scoped snapshot/restore control
# planes, not path labels. Record the real storage controller and volume/dataset identity. Reusing
# an identifier is rejected; commissioning must also prove that the four controls cannot be rolled
# back together.
LETS_STATE_ROLLBACK_DOMAIN=zfs://state-pool/warden-a
LETS_AUTHORITY_STORAGE_BOUNDARY=fenced-filesystem
LETS_AUTHORITY_ROLLBACK_DOMAIN=zfs://authority-pool/warden-a
LETS_AUDIT_ROLLBACK_DOMAIN=zfs://audit-pool/warden-a
LETS_BACKUP_STORAGE_BOUNDARY=dedicated-filesystem
LETS_BACKUP_ROLLBACK_DOMAIN=zfs://backup-pool/warden-a-staging

# This is an operator-attested enforced quota or dedicated filesystem limit. For the example
# 10 GiB logical main-database cap, the 24 GiB boundary covers a full worst-case WAL, its WAL-index,
# and the 1 GiB emergency floor. The validator derives and checks the exact minimum from config.
LETS_STATE_STORAGE_BOUNDARY=dedicated-filesystem
LETS_STATE_CAPACITY_BYTES=25769803776

# The audit archive is append-only and fills independently from core state. This example reserves
# 1 GiB/day for a 365-day commissioned lifecycle plus a 1 GiB emergency floor on a 512 GiB
# dedicated filesystem or enforced quota. Replace these with a measured workload forecast.
LETS_AUDIT_STORAGE_BOUNDARY=dedicated-filesystem
LETS_AUDIT_CAPACITY_BYTES=549755813888
LETS_AUDIT_EXPECTED_DAILY_BYTES=1073741824
LETS_AUDIT_FORECAST_DAYS=365
LETS_AUDIT_MIN_FREE_BYTES=1073741824

# Docker Compose mounts these as secrets. Do not place them in the repository.
LETS_TLS_CERT_FILE=/etc/lets/warden-a/tls/server-cert.pem
LETS_TLS_KEY_FILE=/etc/lets/warden-a/tls/server-key.pem
LETS_CLIENT_CA_FILE=/etc/lets/warden-a/tls/client-ca.pem
LETS_PEER_CA_FILE=/etc/lets/warden-a/tls/peer-ca.pem
LETS_PEER_CERT_FILE=/etc/lets/warden-a/tls/peer-cert.pem
LETS_PEER_KEY_FILE=/etc/lets/warden-a/tls/peer-key.pem

# Loopback is the safe default. Set an explicit interface only behind a controlled firewall.
LETS_BIND_ADDRESS=127.0.0.1
LETS_PORT=8443
LETS_CPUS=2.0
LETS_MEMORY_LIMIT=1g
LETS_LIMIT_CONCURRENCY=64
LETS_BACKLOG=128
LETS_TIMEOUT_KEEP_ALIVE=5
LETS_TIMEOUT_GRACEFUL_SHUTDOWN=30
LETS_HEALTH_START_PERIOD_SECONDS=600
